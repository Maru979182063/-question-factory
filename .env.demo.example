# Copy this file to .env.demo for local development.
# Do not commit real .env files or real tokens.

GENERATION_LLM_API_KEY=
GENERATION_LLM_BASE_URL=https://api.openai.com/v1
MATERIAL_LLM_API_KEY=
MATERIAL_LLM_BASE_URL=https://api.openai.com/v1

# Optional passage-service compatible LLM settings.
PASSAGE_OPENAI_API_KEY=
PASSAGE_OPENAI_BASE_URL=https://api.openai.com/v1
PASSAGE_OPENAI_RESPONSES_FALLBACK=false

# Optional local demo security.
PROMPT_SERVICE_SECURITY_ENABLED=false
PROMPT_SERVICE_API_TOKEN=
PROMPT_SERVICE_RATE_LIMIT_PER_MINUTE=120
PROMPT_GENERATION_MAX_CONCURRENT=2
PROMPT_GENERATION_MAX_QUEUE=12
PROMPT_GENERATION_ACQUIRE_TIMEOUT_SECONDS=240

# Optional ngrok support. Keep the real value only in ignored local env files.
NGROK_AUTHTOKEN=
