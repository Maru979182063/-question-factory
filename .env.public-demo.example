# Public demo profile example.
# Copy this file to .env.public-demo locally and fill real values.
# Do not commit real .env.public-demo.
#
# This profile is intended only behind Cloudflare Access on workbench.example.com/*.
# Do not expose it directly to the public internet without Cloudflare Access.

GENERATION_LLM_API_KEY=
GENERATION_LLM_BASE_URL=https://api.openai.com/v1
MATERIAL_LLM_API_KEY=
MATERIAL_LLM_BASE_URL=https://api.openai.com/v1

# Prompt public demo runtime.
PROMPT_RUNTIME_CONFIG_PATH=configs/question_runtime.public_demo.yaml
PROMPT_QUESTION_DB_PATH=data/public_demo/question_workbench.demo.db
PROMPT_DATA_DIR=data/public_demo
PROMPT_SERVICE_SECURITY_ENABLED=false
PROMPT_SERVICE_RATE_LIMIT_PER_MINUTE=60
PROMPT_GENERATION_MAX_CONCURRENT=1
PROMPT_GENERATION_MAX_QUEUE=6
PROMPT_GENERATION_ACQUIRE_TIMEOUT_SECONDS=240
PROMPT_PUBLIC_DEMO_MODE=true
PROMPT_DISABLE_FASTAPI_DOCS=true

# Public exposure safety.
DISTILL_ACCESS_KEY=
DISTILL_COOKIE_SECURE=true

# Passage internal demo runtime.
PASSAGE_ENV_FILE=.env.public-demo
PASSAGE_DATABASE_URL=sqlite:///./passage_service.demo.db
PASSAGE_DISABLE_FASTAPI_DOCS=true
PASSAGE_DISABLE_SCHEDULER=true
PASSAGE_ALLOW_NON_PRIMARY_DATABASE=true
